generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid()) @unique
  
  email         String?  @unique

  name          String?
  image         String?
  college       String?
  depertment    String?
  location      String?

  emailVerified DateTime?
  accounts      Account[]

  createdAt     DateTime @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}